# /etc/systemd/system/vibeshare-algorithm.service
#   sudo useradd --system --home /var/lib/vibeshare vibeshare
#   sudo systemctl enable --now vibeshare-algorithm
[Unit]
Description=VibeShare search algorithm node
After=network-online.target
Wants=network-online.target

[Service]
User=vibeshare
ExecStart=/usr/local/bin/vibeshare algorithm --data /var/lib/vibeshare/algorithm --public-url https://feed.example.org
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/vibeshare

[Install]
WantedBy=multi-user.target
